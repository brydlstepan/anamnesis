# Copy to .env and fill in.  Generate a secret with:
#   docker compose run --rm anamnesis anamnesis gen-secret
#   (or: python -c "import secrets; print(secrets.token_urlsafe(32))")

# REQUIRED — 32+ chars. Signs sessions; later also encrypts stored tokens. Keep it secret, keep it stable.
ANAMNESIS_SECRET_KEY=

# URL users open in the browser (used for OIDC redirects; https:// enables Secure cookies)
ANAMNESIS_PUBLIC_URL=http://anamnesis.lan:8080

# Admin account (separate, non-patient). Password min. 12 chars; changing it here updates it on restart.
ANAMNESIS_ADMIN_USERNAME=admin
ANAMNESIS_ADMIN_PASSWORD=
# Admin UI lives here (the admin API is always /api/admin)
ANAMNESIS_ADMIN_PATH=/admin

# cs | en
ANAMNESIS_DEFAULT_LANGUAGE=cs

# Optional OIDC (tinyauth, Authentik, Authelia, Keycloak…). Accounts are auto-created on first login;
# who may log in is controlled by your identity provider's allow-list.
# Redirect URI to register at the IdP:  ${ANAMNESIS_PUBLIC_URL}/api/v1/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_DISPLAY_NAME=SSO

# Behind a reverse proxy: IPs allowed to set X-Forwarded-* headers (default 127.0.0.1)
# FORWARDED_ALLOW_IPS=172.18.0.1

# Developer only
# ANAMNESIS_ENABLE_API_DOCS=false

TZ=Europe/Prague
